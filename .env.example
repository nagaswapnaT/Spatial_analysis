# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# --- ESRI GeoAnalytics Engine license ---
GAE_USERNAME=PTL_GAE
GAE_PASSWORD=changeme

# --- AWS (for reaching real S3 + Glue Catalog from the container) ---
# Uses your host ~/.aws mounted into the container (see compose.yaml).
AWS_PROFILE=default
AWS_REGION=us-east-1

# --- GAE library source (jars/zip live here in S3) ---
GAE_LIB_S3_URI=s3://pske-prd-customerexperienceadhoc/maintenance/gae_lib

# --- GAE library versions (must match the files in the bucket) ---
GAE_JAR=geoanalytics_2.12-2.0.0.jar
GAE_NATIVES_JAR=geoanalytics-natives_2.12-2.0.0.jar
GAE_PY_ZIP=geoanalytics-2.0.0.zip

# --- Default source data (override per job) ---
CATALOG_DATABASE=ptledw_playarea
CATALOG_TABLE=d_roadcall_info
ROADCALL_CSV_S3=s3://pske-prd-customerexperienceadhoc/JanakiRam/ARCGIS/Roadcall_Geocode_new.csv
CENSUS_TRACT_S3=s3://pske-prd-customerexperienceadhoc/JanakiRam/ESRI_Layers/cenus_tract/
OUTPUT_S3=s3://pske-prd-customerexperienceadhoc/JanakiRam/Geo_Analytics_Demo/local_dev_output/
